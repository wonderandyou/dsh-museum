{
  "name": "dsh-museum",
  "version": "0.1.0",
  "private": true,
  "description": "把做过的项目收进一座博物馆：自动发现、完工后自动入库，点开能看作用/做法/踩过的坑。",
  "meta": {
    "title": "项目博物馆",
    "description": "把做过的项目收进一座博物馆：自动发现、完工后自动入库，点开能看作用/做法/踩过的坑。"
  },
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": {
      "default": "./lib/host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "museum",
    "projects"
  ],
  "license": "MIT"
}
